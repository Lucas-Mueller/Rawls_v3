"""
Comprehensive Test Suite for FrohlichExperimentManager

This test suite provides complete coverage for the main experiment orchestrator,
focusing on lifecycle management, error handling, and configuration validation.

PHASE 3 IMPROVEMENTS:
- Comprehensive manager class testing
- Error scenario coverage
- Configuration validation
- Lifecycle management testing
- Integration point validation
"""

import pytest
import asyncio
import uuid
from unittest.mock import Mock, AsyncMock, patch, MagicMock
from typing import List, Optional

from core.experiment_manager import FrohlichExperimentManager
from config.models import ExperimentConfiguration, AgentConfiguration
from models import ExperimentResults, ParticipantContext
from models.principle_types import JusticePrinciple
from models import IncomeClass
from experiment_agents.participant_agent import ParticipantAgent
from experiment_agents.utility_agent import UtilityAgent
from utils.error_handling import ExperimentError, SystemError, AgentCommunicationError


class TestExperimentManagerLifecycle:
    """Test complete experiment lifecycle management."""
    
    def test_initialization_with_valid_config(self):
        """Test manager initializes correctly with valid configuration."""
        config = ExperimentConfiguration(
            experiment_id="test_exp",
            agents=[
                AgentConfiguration(name="Alice", language="english", personality="analytical"),
                AgentConfiguration(name="Bob", language="english", personality="collaborative")
            ],
            phase1_config={"rounds": 2},
            phase2_config={"rounds": 3, "voting_detection_mode": "simple"}
        )
        
        manager = FrohlichExperimentManager(config)
        
        assert manager.config == config
        assert manager.experiment_id is not None
        assert len(manager.experiment_id) > 0
        assert manager.participants is None  # Not initialized until async setup
        assert manager.utility_agent is None
    
    def test_initialization_generates_unique_experiment_id(self):
        """Test that each manager instance gets unique experiment ID."""
        config = ExperimentConfiguration(
            experiment_id="test_exp",
            agents=[AgentConfiguration(name="Alice", language="english")]
        )
        
        manager1 = FrohlichExperimentManager(config)
        manager2 = FrohlichExperimentManager(config)
        
        assert manager1.experiment_id != manager2.experiment_id
    
    @pytest.mark.asyncio
    async def test_async_initialization_success(self):
        """Test successful asynchronous agent initialization."""
        config = ExperimentConfiguration(
            experiment_id="test_exp",
            agents=[
                AgentConfiguration(name="Alice", language="english", model="gpt-4o-mini"),
                AgentConfiguration(name="Bob", language="spanish", model="gpt-4o-mini")
            ]
        )
        
        with patch('experiment_agents.create_participant_agents_with_dynamic_temperature') as mock_create_participants, \
             patch('experiment_agents.UtilityAgent') as mock_utility_agent_class:
            
            # Mock participant agent creation
            mock_participants = [Mock(spec=ParticipantAgent), Mock(spec=ParticipantAgent)]
            mock_create_participants.return_value = mock_participants
            
            # Mock utility agent creation
            mock_utility_agent = Mock(spec=UtilityAgent)
            mock_utility_agent_class.return_value = mock_utility_agent
            
            manager = FrohlichExperimentManager(config)
            await manager.async_init()
            
            assert manager.participants == mock_participants
            assert manager.utility_agent == mock_utility_agent
            mock_create_participants.assert_called_once()
            mock_utility_agent_class.assert_called_once()
    
    @pytest.mark.asyncio
    async def test_async_initialization_failure(self):
        """Test handling of async initialization failures."""
        config = ExperimentConfiguration(
            experiment_id="test_exp",
            agents=[AgentConfiguration(name="Alice", language="english")]
        )
        
        with patch('experiment_agents.create_participant_agents_with_dynamic_temperature') as mock_create:
            mock_create.side_effect = Exception("Agent creation failed")
            
            manager = FrohlichExperimentManager(config)
            
            with pytest.raises(SystemError):
                await manager.async_init()


class TestExperimentManagerExecution:
    """Test experiment execution and orchestration."""
    
    @pytest.fixture
    def mock_manager_with_agents(self):
        """Create a manager with mocked agents for testing."""
        config = ExperimentConfiguration(
            experiment_id="test_exp",
            agents=[
                AgentConfiguration(name="Alice", language="english"),
                AgentConfiguration(name="Bob", language="english")
            ],
            phase1_config={"rounds": 2},
            phase2_config={"rounds": 3}
        )
        
        manager = FrohlichExperimentManager(config)
        manager.participants = [Mock(spec=ParticipantAgent), Mock(spec=ParticipantAgent)]
        manager.utility_agent = Mock(spec=UtilityAgent)
        manager.phase1_manager = Mock()
        manager.phase2_manager = Mock()
        
        return manager
    
    @pytest.mark.asyncio
    async def test_successful_experiment_execution(self, mock_manager_with_agents):
        """Test successful end-to-end experiment execution."""
        manager = mock_manager_with_agents
        
        # Mock phase results
        phase1_results = [Mock(), Mock()]  # Two participants
        phase2_results = Mock()
        phase2_results.consensus_reached = True
        phase2_results.agreed_principle = JusticePrinciple.MAXIMIZING_FLOOR
        
        manager.phase1_manager.run_phase1.return_value = phase1_results
        manager.phase2_manager.run_phase2.return_value = phase2_results
        
        with patch.object(manager, '_compile_experiment_results') as mock_compile:
            expected_results = Mock(spec=ExperimentResults)
            mock_compile.return_value = expected_results
            
            results = await manager.run_experiment()
            
            assert results == expected_results
            manager.phase1_manager.run_phase1.assert_called_once()
            manager.phase2_manager.run_phase2.assert_called_once()
            mock_compile.assert_called_once_with(phase1_results, phase2_results)
    
    @pytest.mark.asyncio
    async def test_experiment_execution_phase1_failure(self, mock_manager_with_agents):
        """Test experiment execution when Phase 1 fails."""
        manager = mock_manager_with_agents
        
        manager.phase1_manager.run_phase1.side_effect = ExperimentError("Phase 1 failed")
        
        with pytest.raises(ExperimentError, match="Phase 1 failed"):
            await manager.run_experiment()
    
    @pytest.mark.asyncio
    async def test_experiment_execution_phase2_failure(self, mock_manager_with_agents):
        """Test experiment execution when Phase 2 fails."""
        manager = mock_manager_with_agents
        
        # Phase 1 succeeds
        phase1_results = [Mock(), Mock()]
        manager.phase1_manager.run_phase1.return_value = phase1_results
        
        # Phase 2 fails
        manager.phase2_manager.run_phase2.side_effect = AgentCommunicationError("Phase 2 failed")
        
        with pytest.raises(AgentCommunicationError, match="Phase 2 failed"):
            await manager.run_experiment()
    
    @pytest.mark.asyncio
    async def test_experiment_execution_without_initialization(self):
        """Test experiment execution fails without proper initialization."""
        config = ExperimentConfiguration(
            experiment_id="test_exp",
            agents=[AgentConfiguration(name="Alice", language="english")]
        )
        
        manager = FrohlichExperimentManager(config)
        # Don't call async_init()
        
        with pytest.raises(SystemError, match="async_init"):
            await manager.run_experiment()


class TestExperimentManagerConfiguration:
    """Test configuration validation and handling."""
    
    def test_configuration_validation_valid(self):
        """Test validation accepts valid configurations."""
        valid_configs = [
            ExperimentConfiguration(
                experiment_id="test1",
                agents=[AgentConfiguration(name="Alice", language="english")]
            ),
            ExperimentConfiguration(
                experiment_id="test2",
                agents=[
                    AgentConfiguration(name="Alice", language="english"),
                    AgentConfiguration(name="Bob", language="spanish"),
                    AgentConfiguration(name="Charlie", language="mandarin")
                ],
                phase1_config={"rounds": 3},
                phase2_config={"rounds": 5, "voting_detection_mode": "complex"}
            )
        ]
        
        for config in valid_configs:
            manager = FrohlichExperimentManager(config)
            # Should not raise any exceptions
            assert manager.config == config
    
    def test_configuration_validation_missing_agents(self):
        """Test validation rejects configurations with no agents."""
        with pytest.raises(ValueError, match="at least one agent"):
            ExperimentConfiguration(
                experiment_id="test_exp",
                agents=[]
            )
    
    def test_configuration_validation_invalid_language(self):
        """Test validation handles invalid language specifications."""
        with pytest.raises(ValueError):
            ExperimentConfiguration(
                experiment_id="test_exp",
                agents=[AgentConfiguration(name="Alice", language="invalid_language")]
            )
    
    def test_configuration_validation_invalid_voting_mode(self):
        """Test validation handles invalid voting detection modes."""
        with pytest.raises(ValueError):
            ExperimentConfiguration(
                experiment_id="test_exp", 
                agents=[AgentConfiguration(name="Alice", language="english")],
                phase2_config={"voting_detection_mode": "invalid_mode"}
            )


class TestExperimentManagerErrorHandling:
    """Test comprehensive error handling scenarios."""
    
    @pytest.mark.asyncio
    async def test_agent_communication_error_handling(self):
        """Test handling of agent communication failures."""
        config = ExperimentConfiguration(
            experiment_id="test_exp",
            agents=[AgentConfiguration(name="Alice", language="english")]
        )
        
        manager = FrohlichExperimentManager(config)
        
        with patch('experiment_agents.create_participant_agents_with_dynamic_temperature') as mock_create:
            mock_create.side_effect = AgentCommunicationError("Network timeout")
            
            with pytest.raises(SystemError):
                await manager.async_init()
    
    @pytest.mark.asyncio
    async def test_memory_limit_error_handling(self):
        """Test handling of memory limit scenarios."""
        config = ExperimentConfiguration(
            experiment_id="test_exp",
            agents=[AgentConfiguration(name="Alice", language="english")]
        )
        
        manager = FrohlichExperimentManager(config)
        manager.participants = [Mock(spec=ParticipantAgent)]
        manager.utility_agent = Mock(spec=UtilityAgent)
        manager.phase1_manager = Mock()
        
        # Simulate memory limit during Phase 1
        manager.phase1_manager.run_phase1.side_effect = SystemError("Memory limit exceeded")
        
        with pytest.raises(SystemError, match="Memory limit exceeded"):
            await manager.run_experiment()
    
    @pytest.mark.asyncio
    async def test_timeout_error_handling(self):
        """Test handling of timeout scenarios."""
        config = ExperimentConfiguration(
            experiment_id="test_exp",
            agents=[AgentConfiguration(name="Alice", language="english")],
            timeout_seconds=1.0
        )
        
        manager = FrohlichExperimentManager(config)
        manager.participants = [Mock(spec=ParticipantAgent)]
        manager.utility_agent = Mock(spec=UtilityAgent)
        manager.phase1_manager = Mock()
        
        # Mock Phase 1 taking too long
        async def slow_phase1(*args, **kwargs):
            await asyncio.sleep(2.0)  # Longer than timeout
            return []
        
        manager.phase1_manager.run_phase1.side_effect = slow_phase1
        
        with pytest.raises(asyncio.TimeoutError):
            await asyncio.wait_for(manager.run_experiment(), timeout=config.timeout_seconds)
    
    def test_error_recovery_mechanism(self):
        """Test error recovery and retry mechanisms."""
        config = ExperimentConfiguration(
            experiment_id="test_exp",
            agents=[AgentConfiguration(name="Alice", language="english")],
            max_retries=3
        )
        
        manager = FrohlichExperimentManager(config)
        
        # Test that retry configuration is properly set
        assert manager.config.max_retries == 3


class TestExperimentManagerIntegration:
    """Test integration points with other system components."""
    
    def test_phase_manager_integration(self):
        """Test integration with Phase1Manager and Phase2Manager."""
        config = ExperimentConfiguration(
            experiment_id="test_exp",
            agents=[AgentConfiguration(name="Alice", language="english")]
        )
        
        with patch('core.Phase1Manager') as mock_phase1_class, \
             patch('core.Phase2Manager') as mock_phase2_class:
            
            manager = FrohlichExperimentManager(config)
            manager.participants = [Mock(spec=ParticipantAgent)]
            manager.utility_agent = Mock(spec=UtilityAgent)
            
            # Initialize phase managers
            manager._initialize_phase_managers()
            
            # Verify phase managers are created with correct parameters
            mock_phase1_class.assert_called_once()
            mock_phase2_class.assert_called_once()
    
    def test_language_manager_integration(self):
        """Test integration with language management system."""
        multilingual_config = ExperimentConfiguration(
            experiment_id="test_exp",
            agents=[
                AgentConfiguration(name="Alice", language="english"),
                AgentConfiguration(name="Ana", language="spanish"),
                AgentConfiguration(name="李明", language="mandarin")
            ]
        )
        
        manager = FrohlichExperimentManager(multilingual_config)
        
        # Verify language handling capabilities
        assert manager.config.agents[0].language == "english"
        assert manager.config.agents[1].language == "spanish"
        assert manager.config.agents[2].language == "mandarin"
    
    def test_memory_manager_integration(self):
        """Test integration with memory management system."""
        config = ExperimentConfiguration(
            experiment_id="test_exp",
            agents=[AgentConfiguration(name="Alice", language="english")],
            memory_config={
                "max_character_limit": 5000,
                "memory_guidance_style": "narrative"
            }
        )
        
        manager = FrohlichExperimentManager(config)
        
        # Verify memory configuration is passed through
        assert manager.config.memory_config["max_character_limit"] == 5000
        assert manager.config.memory_config["memory_guidance_style"] == "narrative"


class TestExperimentManagerResults:
    """Test experiment results compilation and reporting."""
    
    def test_results_compilation_success(self):
        """Test successful compilation of experiment results."""
        config = ExperimentConfiguration(
            experiment_id="test_exp",
            agents=[
                AgentConfiguration(name="Alice", language="english"),
                AgentConfiguration(name="Bob", language="english")
            ]
        )
        
        manager = FrohlichExperimentManager(config)
        
        # Mock phase results
        phase1_results = [
            Mock(participant_name="Alice", final_principle_choice=JusticePrinciple.MAXIMIZING_FLOOR),
            Mock(participant_name="Bob", final_principle_choice=JusticePrinciple.MAXIMIZING_AVERAGE)
        ]
        
        phase2_results = Mock()
        phase2_results.consensus_reached = True
        phase2_results.agreed_principle = JusticePrinciple.MAXIMIZING_FLOOR
        phase2_results.total_rounds = 3
        phase2_results.voting_occurred = True
        
        results = manager._compile_experiment_results(phase1_results, phase2_results)
        
        assert isinstance(results, ExperimentResults)
        assert results.experiment_id == config.experiment_id
        assert results.consensus_reached == True
        assert results.agreed_principle == JusticePrinciple.MAXIMIZING_FLOOR
        assert len(results.phase1_results) == 2
    
    def test_results_compilation_no_consensus(self):
        """Test results compilation when no consensus is reached."""
        config = ExperimentConfiguration(
            experiment_id="test_exp",
            agents=[AgentConfiguration(name="Alice", language="english")]
        )
        
        manager = FrohlichExperimentManager(config)
        
        phase1_results = [Mock(participant_name="Alice")]
        phase2_results = Mock()
        phase2_results.consensus_reached = False
        phase2_results.agreed_principle = None
        phase2_results.total_rounds = 5
        
        results = manager._compile_experiment_results(phase1_results, phase2_results)
        
        assert results.consensus_reached == False
        assert results.agreed_principle is None
    
    def test_results_include_performance_metrics(self):
        """Test that results include performance and timing metrics."""
        config = ExperimentConfiguration(
            experiment_id="test_exp",
            agents=[AgentConfiguration(name="Alice", language="english")]
        )
        
        manager = FrohlichExperimentManager(config)
        
        phase1_results = [Mock(participant_name="Alice")]
        phase2_results = Mock()
        phase2_results.consensus_reached = True
        phase2_results.agreed_principle = JusticePrinciple.MAXIMIZING_FLOOR
        
        with patch('time.time', side_effect=[1000.0, 1100.0]):  # 100 second experiment
            results = manager._compile_experiment_results(phase1_results, phase2_results)
        
        # Results should include timing information
        assert hasattr(results, 'execution_time_seconds')


class TestExperimentManagerPerformance:
    """Test performance characteristics and optimization."""
    
    @pytest.mark.asyncio
    async def test_concurrent_agent_initialization(self):
        """Test that agent initialization happens concurrently for performance."""
        config = ExperimentConfiguration(
            experiment_id="test_exp",
            agents=[
                AgentConfiguration(name=f"Agent{i}", language="english") 
                for i in range(5)
            ]
        )
        
        with patch('experiment_agents.create_participant_agents_with_dynamic_temperature') as mock_create, \
             patch('experiment_agents.UtilityAgent') as mock_utility_class:
            
            mock_participants = [Mock(spec=ParticipantAgent) for _ in range(5)]
            mock_create.return_value = mock_participants
            mock_utility_class.return_value = Mock(spec=UtilityAgent)
            
            manager = FrohlichExperimentManager(config)
            
            start_time = asyncio.get_event_loop().time()
            await manager.async_init()
            end_time = asyncio.get_event_loop().time()
            
            # Initialization should be fast (concurrent)
            assert end_time - start_time < 1.0  # Should complete quickly
            mock_create.assert_called_once()
    
    def test_memory_usage_optimization(self):
        """Test memory usage optimization strategies."""
        config = ExperimentConfiguration(
            experiment_id="test_exp",
            agents=[AgentConfiguration(name="Alice", language="english")],
            memory_config={"max_character_limit": 1000}  # Small limit for testing
        )
        
        manager = FrohlichExperimentManager(config)
        
        # Verify memory optimization settings are applied
        assert manager.config.memory_config["max_character_limit"] == 1000
    
    def test_resource_cleanup(self):
        """Test that resources are properly cleaned up after experiment."""
        config = ExperimentConfiguration(
            experiment_id="test_exp",
            agents=[AgentConfiguration(name="Alice", language="english")]
        )
        
        manager = FrohlichExperimentManager(config)
        manager.participants = [Mock(spec=ParticipantAgent)]
        manager.utility_agent = Mock(spec=UtilityAgent)
        
        # Test cleanup method exists and can be called
        if hasattr(manager, 'cleanup'):
            manager.cleanup()
        
        # Verify cleanup doesn't raise exceptions
        assert True


class TestExperimentManagerEdgeCases:
    """Test edge cases and boundary conditions."""
    
    def test_single_agent_experiment(self):
        """Test experiment with single agent (edge case)."""
        config = ExperimentConfiguration(
            experiment_id="single_agent_test",
            agents=[AgentConfiguration(name="Alice", language="english")]
        )
        
        manager = FrohlichExperimentManager(config)
        
        # Single agent experiments should still initialize properly
        assert len(manager.config.agents) == 1
        assert manager.config.agents[0].name == "Alice"
    
    def test_maximum_agents_experiment(self):
        """Test experiment with maximum number of agents."""
        max_agents = 10  # Define reasonable maximum
        config = ExperimentConfiguration(
            experiment_id="max_agents_test",
            agents=[
                AgentConfiguration(name=f"Agent{i}", language="english") 
                for i in range(max_agents)
            ]
        )
        
        manager = FrohlichExperimentManager(config)
        
        # Should handle maximum agents without issues
        assert len(manager.config.agents) == max_agents
    
    def test_unicode_handling_in_experiment_id(self):
        """Test handling of Unicode characters in experiment identifiers."""
        config = ExperimentConfiguration(
            experiment_id="实验_测试_🧪",  # Chinese and emoji
            agents=[AgentConfiguration(name="Alice", language="mandarin")]
        )
        
        manager = FrohlichExperimentManager(config)
        
        # Should handle Unicode experiment IDs properly
        assert manager.config.experiment_id == "实验_测试_🧪"
    
    def test_empty_phase_configuration(self):
        """Test handling of empty or minimal phase configurations."""
        config = ExperimentConfiguration(
            experiment_id="minimal_test",
            agents=[AgentConfiguration(name="Alice", language="english")],
            phase1_config={},  # Empty configuration
            phase2_config={}
        )
        
        manager = FrohlichExperimentManager(config)
        
        # Should apply default values for empty configurations
        assert manager.config.phase1_config is not None
        assert manager.config.phase2_config is not None


# PERFORMANCE VALIDATION
class TestExperimentManagerPerformanceValidation:
    """Validate performance improvements achieved in Phase 3."""
    
    def test_initialization_speed_target_met(self):
        """Test that initialization meets speed targets."""
        config = ExperimentConfiguration(
            experiment_id="perf_test",
            agents=[AgentConfiguration(name="Alice", language="english")]
        )
        
        import time
        start_time = time.time()
        manager = FrohlichExperimentManager(config)
        end_time = time.time()
        
        # Synchronous initialization should be very fast
        assert end_time - start_time < 0.01  # Less than 10ms
    
    def test_memory_efficiency_validation(self):
        """Test memory efficiency of manager instances."""
        import sys
        
        config = ExperimentConfiguration(
            experiment_id="memory_test",
            agents=[AgentConfiguration(name="Alice", language="english")]
        )
        
        # Measure memory usage
        manager = FrohlichExperimentManager(config)
        
        # Manager should have reasonable memory footprint
        # (Exact measurement would require memory profiling tools)
        assert manager is not None  # Basic validation
    
    def test_error_handling_performance(self):
        """Test that error handling doesn't significantly impact performance."""
        config = ExperimentConfiguration(
            experiment_id="error_perf_test",
            agents=[AgentConfiguration(name="Alice", language="english")]
        )
        
        manager = FrohlichExperimentManager(config)
        
        import time
        start_time = time.time()
        
        # Test rapid error handling
        for _ in range(100):
            try:
                # This will raise an error (participants not initialized)
                manager._validate_initialization()
            except SystemError:
                pass
        
        end_time = time.time()
        
        # Error handling should be fast
        assert end_time - start_time < 0.1  # Less than 100ms for 100 error checks