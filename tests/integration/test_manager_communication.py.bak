"""
Integration Tests for Manager Communication

This test suite validates communication and coordination between different
manager components in the Frohlich Experiment system.

PHASE 3 IMPROVEMENTS:
- Manager-to-manager communication testing
- Agent-to-utility-agent workflow validation
- Configuration-to-execution pipeline testing
- End-to-end integration scenarios
"""

import pytest
import asyncio
from unittest.mock import Mock, AsyncMock, patch, MagicMock

from core.experiment_manager import FrohlichExperimentManager
from core.phase1_manager import Phase1Manager
from core.phase2_manager import Phase2Manager
from config.models import ExperimentConfiguration, AgentConfiguration
from models import (
    ExperimentResults, Phase1Results, Phase2Results,
    ParticipantContext
)
from models.principle_types import JusticePrinciple
from experiment_agents.participant_agent import ParticipantAgent
from experiment_agents.utility_agent import UtilityAgent


class TestExperimentManagerToPhaseManagerCommunication:
    """Test communication between ExperimentManager and phase managers."""
    
    @pytest.fixture
    def experiment_config(self):
        """Standard experiment configuration for testing."""
        return ExperimentConfiguration(
            experiment_id="integration_test",
            agents=[
                AgentConfiguration(name="Alice", language="english"),
                AgentConfiguration(name="Bob", language="spanish")
            ],
            phase1_config={"rounds": 2},
            phase2_config={"rounds": 3, "voting_detection_mode": "simple"}
        )
    
    @pytest.mark.asyncio
    async def test_experiment_manager_phase1_communication(self, experiment_config):
        """Test ExperimentManager communication with Phase1Manager."""
        with patch('experiment_agents.create_participant_agents_with_dynamic_temperature') as mock_participants, \
             patch('experiment_agents.UtilityAgent') as mock_utility_class, \
             patch('core.Phase1Manager') as mock_phase1_class:
            
            # Mock agent creation
            mock_participants.return_value = [Mock(spec=ParticipantAgent), Mock(spec=ParticipantAgent)]
            mock_utility_agent = Mock(spec=UtilityAgent)
            mock_utility_class.return_value = mock_utility_agent
            
            # Mock Phase1Manager
            mock_phase1_manager = Mock(spec=Phase1Manager)
            mock_phase1_results = [
                Mock(spec=Phase1Results, participant_name="Alice"),
                Mock(spec=Phase1Results, participant_name="Bob")
            ]
            mock_phase1_manager.run_phase1.return_value = mock_phase1_results
            mock_phase1_class.return_value = mock_phase1_manager
            
            # Mock Phase2Manager to focus on Phase 1 communication
            with patch('core.Phase2Manager') as mock_phase2_class:
                mock_phase2_manager = Mock(spec=Phase2Manager)
                mock_phase2_results = Mock(spec=Phase2Results, consensus_reached=True)
                mock_phase2_manager.run_phase2.return_value = mock_phase2_results
                mock_phase2_class.return_value = mock_phase2_manager
                
                # Test the communication
                experiment_manager = FrohlichExperimentManager(experiment_config)
                await experiment_manager.async_init()
                results = await experiment_manager.run_experiment()
                
                # Verify Phase1Manager was called correctly
                mock_phase1_manager.run_phase1.assert_called_once_with(
                    experiment_config, experiment_manager.logger
                )
                
                # Verify Phase1 results were passed to Phase2
                mock_phase2_manager.run_phase2.assert_called_once()
                phase2_call_args = mock_phase2_manager.run_phase2.call_args
                assert phase2_call_args[0][1] == mock_phase1_results  # Phase1 results passed as contexts
    
    @pytest.mark.asyncio
    async def test_experiment_manager_phase2_communication(self, experiment_config):
        """Test ExperimentManager communication with Phase2Manager."""
        with patch('experiment_agents.create_participant_agents_with_dynamic_temperature') as mock_participants, \
             patch('experiment_agents.UtilityAgent') as mock_utility_class, \
             patch('core.Phase1Manager') as mock_phase1_class, \
             patch('core.Phase2Manager') as mock_phase2_class:
            
            # Mock dependencies
            mock_participants.return_value = [Mock(spec=ParticipantAgent), Mock(spec=ParticipantAgent)]
            mock_utility_class.return_value = Mock(spec=UtilityAgent)
            
            # Mock Phase1 results
            phase1_results = [Mock(spec=Phase1Results), Mock(spec=Phase1Results)]
            mock_phase1_manager = Mock(spec=Phase1Manager)
            mock_phase1_manager.run_phase1.return_value = phase1_results
            mock_phase1_class.return_value = mock_phase1_manager
            
            # Mock Phase2Manager
            mock_phase2_manager = Mock(spec=Phase2Manager)
            phase2_results = Mock(spec=Phase2Results)
            phase2_results.consensus_reached = True
            phase2_results.agreed_principle = JusticePrinciple.MAXIMIZING_FLOOR
            mock_phase2_manager.run_phase2.return_value = phase2_results
            mock_phase2_class.return_value = mock_phase2_manager
            
            # Test the communication
            experiment_manager = FrohlichExperimentManager(experiment_config)
            await experiment_manager.async_init()
            results = await experiment_manager.run_experiment()
            
            # Verify Phase2Manager received correct parameters
            mock_phase2_manager.run_phase2.assert_called_once()
            call_args = mock_phase2_manager.run_phase2.call_args
            
            # Should receive experiment config, Phase1 results as contexts, and logger
            assert call_args[0][0] == experiment_config
            assert call_args[0][1] == phase1_results
            assert call_args[0][2] == experiment_manager.logger
    
    @pytest.mark.asyncio
    async def test_phase_transition_data_flow(self, experiment_config):
        """Test data flow from Phase 1 to Phase 2."""
        with patch('experiment_agents.create_participant_agents_with_dynamic_temperature') as mock_participants, \
             patch('experiment_agents.UtilityAgent') as mock_utility_class:
            
            # Create real manager to test actual data flow
            mock_participants.return_value = [Mock(spec=ParticipantAgent), Mock(spec=ParticipantAgent)]
            mock_utility_class.return_value = Mock(spec=UtilityAgent)
            
            experiment_manager = FrohlichExperimentManager(experiment_config)
            await experiment_manager.async_init()
            
            # Mock Phase1 results with specific data
            phase1_results = [
                Mock(spec=Phase1Results, 
                     participant_name="Alice", 
                     final_principle_choice=JusticePrinciple.MAXIMIZING_FLOOR),
                Mock(spec=Phase1Results, 
                     participant_name="Bob", 
                     final_principle_choice=JusticePrinciple.MAXIMIZING_AVERAGE)
            ]
            
            with patch.object(experiment_manager.phase1_manager, 'run_phase1') as mock_phase1:
                mock_phase1.return_value = phase1_results
                
                with patch.object(experiment_manager.phase2_manager, 'run_phase2') as mock_phase2:
                    mock_phase2_results = Mock(spec=Phase2Results, consensus_reached=True)
                    mock_phase2.return_value = mock_phase2_results
                    
                    results = await experiment_manager.run_experiment()
                    
                    # Verify Phase2 received Phase1 results as contexts
                    phase2_call_args = mock_phase2.call_args[0]
                    contexts_passed = phase2_call_args[1]
                    
                    assert contexts_passed == phase1_results
                    assert len(contexts_passed) == 2
                    assert contexts_passed[0].participant_name == "Alice"
                    assert contexts_passed[1].participant_name == "Bob"


class TestManagerToAgentCommunication:
    """Test communication between managers and agents."""
    
    @pytest.fixture
    def mock_agents(self):
        """Create mocked agents for testing."""
        participants = [
            Mock(spec=ParticipantAgent, name="Alice"),
            Mock(spec=ParticipantAgent, name="Bob")
        ]
        utility_agent = Mock(spec=UtilityAgent)
        return participants, utility_agent
    
    @pytest.mark.asyncio
    async def test_phase1_manager_to_participant_communication(self, mock_agents):
        """Test Phase1Manager communication with participant agents."""
        participants, utility_agent = mock_agents
        language_manager = Mock()
        
        phase1_manager = Phase1Manager(participants, utility_agent, language_manager)
        
        config = ExperimentConfiguration(
            experiment_id="comm_test",
            agents=[
                AgentConfiguration(name="Alice", language="english"),
                AgentConfiguration(name="Bob", language="spanish")
            ],
            phase1_config={"rounds": 2}
        )
        
        # Mock participant responses
        participants[0].run.return_value = Mock(messages=["I prefer principle A"])
        participants[1].run.return_value = Mock(messages=["Prefiero el principio A"])
        
        # Mock utility agent parsing
        utility_agent.parse_principle_choice_enhanced.return_value = Mock(
            success=True, principle=JusticePrinciple.MAXIMIZING_FLOOR
        )
        
        with patch.object(phase1_manager, '_run_single_participant_phase1') as mock_single:
            mock_results = [Mock(spec=Phase1Results), Mock(spec=Phase1Results)]
            mock_single.side_effect = mock_results
            
            results = await phase1_manager.run_phase1(config)
            
            # Verify each participant was called
            assert mock_single.call_count == 2
            assert len(results) == 2
    
    @pytest.mark.asyncio
    async def test_phase2_manager_to_participant_communication(self, mock_agents):
        """Test Phase2Manager communication with participant agents."""
        participants, utility_agent = mock_agents
        language_manager = Mock()
        
        phase2_manager = Phase2Manager(participants, utility_agent, language_manager)
        
        config = ExperimentConfiguration(
            experiment_id="comm_test",
            agents=[AgentConfiguration(name="Alice", language="english")],
            phase2_config={"rounds": 3}
        )
        
        contexts = [Mock(spec=ParticipantContext, participant_name="Alice")]
        logger = Mock()
        
        # Mock participant discussion responses
        participants[0].run.return_value = Mock(messages=["Let's discuss this principle"])
        participants[1].run.return_value = Mock(messages=["I agree with that choice"])
        
        # Mock utility agent parsing
        utility_agent.parse_principle_choice_enhanced.return_value = Mock(
            success=True, principle=JusticePrinciple.MAXIMIZING_FLOOR
        )
        
        with patch.object(phase2_manager, '_check_for_consensus') as mock_consensus:
            mock_consensus.side_effect = [False, False, True]  # Consensus on round 3
            
            with patch.object(phase2_manager, '_create_phase2_results') as mock_results:
                mock_results.return_value = Mock(spec=Phase2Results, consensus_reached=True)
                
                results = await phase2_manager.run_phase2(config, contexts, logger)
                
                # Verify participants were involved in discussion
                assert participants[0].run.called
                assert participants[1].run.called
                assert results.consensus_reached is True
    
    def test_utility_agent_parsing_integration(self, mock_agents):
        """Test integration between managers and utility agent for parsing."""
        participants, utility_agent = mock_agents
        language_manager = Mock()
        
        phase1_manager = Phase1Manager(participants, utility_agent, language_manager)
        
        # Test various parsing scenarios
        test_responses = [
            ("I choose principle A", JusticePrinciple.MAXIMIZING_FLOOR),
            ("My preference is maximizing average", JusticePrinciple.MAXIMIZING_AVERAGE),
            ("I prefer the constrained approach", JusticePrinciple.MAXIMIZING_AVERAGE_FLOOR_CONSTRAINT)
        ]
        
        for response_text, expected_principle in test_responses:
            # Mock utility agent response
            utility_agent.parse_principle_choice_enhanced.return_value = Mock(
                success=True, 
                principle=expected_principle,
                raw_text=response_text
            )
            
            # Test parsing integration
            parse_result = utility_agent.parse_principle_choice_enhanced(response_text)
            
            assert parse_result.success is True
            assert parse_result.principle == expected_principle


class TestConfigurationToExecutionPipeline:
    """Test the configuration-to-execution pipeline integration."""
    
    def test_configuration_propagation_to_managers(self):
        """Test that configuration is properly propagated to all managers."""
        config = ExperimentConfiguration(
            experiment_id="config_test",
            agents=[
                AgentConfiguration(name="Alice", language="english", model="gpt-4o-mini"),
                AgentConfiguration(name="Bob", language="spanish", model="gpt-4o-mini")
            ],
            phase1_config={"rounds": 3, "memory_limit": 2000},
            phase2_config={"rounds": 5, "voting_detection_mode": "complex"},
            memory_config={"max_character_limit": 5000}
        )
        
        with patch('experiment_agents.create_participant_agents_with_dynamic_temperature') as mock_participants, \
             patch('experiment_agents.UtilityAgent') as mock_utility_class:
            
            mock_participants.return_value = [Mock(spec=ParticipantAgent), Mock(spec=ParticipantAgent)]
            mock_utility_class.return_value = Mock(spec=UtilityAgent)
            
            experiment_manager = FrohlichExperimentManager(config)
            
            # Verify configuration is stored
            assert experiment_manager.config == config
            assert experiment_manager.config.phase1_config["rounds"] == 3
            assert experiment_manager.config.phase2_config["voting_detection_mode"] == "complex"
            assert experiment_manager.config.memory_config["max_character_limit"] == 5000
    
    @pytest.mark.asyncio
    async def test_agent_configuration_to_creation_pipeline(self):
        """Test pipeline from agent configuration to agent creation."""
        config = ExperimentConfiguration(
            experiment_id="agent_config_test",
            agents=[
                AgentConfiguration(
                    name="Alice", 
                    language="english", 
                    model="gpt-4o-mini",
                    temperature=0.7,
                    personality="analytical"
                ),
                AgentConfiguration(
                    name="Bob", 
                    language="spanish", 
                    model="gpt-4o-mini",
                    temperature=0.9,
                    personality="creative"
                )
            ]
        )
        
        with patch('experiment_agents.create_participant_agents_with_dynamic_temperature') as mock_create_agents:
            mock_agents = [Mock(spec=ParticipantAgent), Mock(spec=ParticipantAgent)]
            mock_create_agents.return_value = mock_agents
            
            with patch('experiment_agents.UtilityAgent') as mock_utility_class:
                mock_utility_class.return_value = Mock(spec=UtilityAgent)
                
                experiment_manager = FrohlichExperimentManager(config)
                await experiment_manager.async_init()
                
                # Verify agent creation was called with correct configuration
                mock_create_agents.assert_called_once()
                call_args = mock_create_agents.call_args[0]
                
                # Should receive agent configurations and language manager
                assert len(call_args[0]) == 2  # Two agent configs
                assert call_args[0][0].name == "Alice"
                assert call_args[0][1].name == "Bob"
    
    @pytest.mark.asyncio
    async def test_multilingual_configuration_pipeline(self):
        """Test multilingual configuration pipeline."""
        config = ExperimentConfiguration(
            experiment_id="multilingual_test",
            agents=[
                AgentConfiguration(name="Alice", language="english"),
                AgentConfiguration(name="Ana", language="spanish"),
                AgentConfiguration(name="李明", language="mandarin")
            ],
            supported_languages=["english", "spanish", "mandarin"]
        )
        
        with patch('experiment_agents.create_participant_agents_with_dynamic_temperature') as mock_participants, \
             patch('experiment_agents.UtilityAgent') as mock_utility_class, \
             patch('utils.language_manager.LanguageManager') as mock_language_class:
            
            # Mock multilingual setup
            mock_participants.return_value = [Mock(spec=ParticipantAgent) for _ in range(3)]
            mock_utility_class.return_value = Mock(spec=UtilityAgent)
            
            mock_language_manager = Mock()
            mock_language_manager.get_supported_languages.return_value = ["english", "spanish", "mandarin"]
            mock_language_class.return_value = mock_language_manager
            
            experiment_manager = FrohlichExperimentManager(config)
            await experiment_manager.async_init()
            
            # Verify multilingual setup
            assert len(experiment_manager.participants) == 3
            assert experiment_manager.config.supported_languages == ["english", "spanish", "mandarin"]


class TestEndToEndIntegrationScenarios:
    """Test complete end-to-end integration scenarios."""
    
    @pytest.mark.asyncio
    async def test_simple_consensus_end_to_end(self):
        """Test complete experiment with simple consensus achievement."""
        config = ExperimentConfiguration(
            experiment_id="e2e_simple",
            agents=[
                AgentConfiguration(name="Alice", language="english"),
                AgentConfiguration(name="Bob", language="english")
            ],
            phase1_config={"rounds": 2},
            phase2_config={"rounds": 3, "voting_detection_mode": "simple"}
        )
        
        with patch('experiment_agents.create_participant_agents_with_dynamic_temperature') as mock_participants, \
             patch('experiment_agents.UtilityAgent') as mock_utility_class:
            
            # Create mocked agents
            mock_alice = Mock(spec=ParticipantAgent, name="Alice")
            mock_bob = Mock(spec=ParticipantAgent, name="Bob")
            mock_participants.return_value = [mock_alice, mock_bob]
            
            mock_utility_agent = Mock(spec=UtilityAgent)
            mock_utility_class.return_value = mock_utility_agent
            
            # Mock Phase 1 responses (individual familiarization)
            mock_alice.run.side_effect = [
                Mock(messages=["I'm learning about principle A"]),
                Mock(messages=["I choose principle A - maximizing floor"])
            ]
            mock_bob.run.side_effect = [
                Mock(messages=["I'm considering the principles"]),
                Mock(messages=["I also choose principle A"])
            ]
            
            # Mock utility agent parsing for Phase 1
            mock_utility_agent.parse_principle_choice_enhanced.side_effect = [
                Mock(success=True, principle=JusticePrinciple.MAXIMIZING_FLOOR),  # Alice
                Mock(success=True, principle=JusticePrinciple.MAXIMIZING_FLOOR)   # Bob
            ]
            
            # Mock Phase 2 responses (group discussion)
            mock_alice.run.side_effect.extend([
                Mock(messages=["My preference is principle A"]),
                Mock(messages=["I agree with principle A"])
            ])
            mock_bob.run.side_effect.extend([
                Mock(messages=["My preference is also principle A"]),
                Mock(messages=["Yes, I agree with principle A"])
            ])
            
            # Continue mocking utility agent for Phase 2
            mock_utility_agent.parse_principle_choice_enhanced.side_effect.extend([
                Mock(success=True, principle=JusticePrinciple.MAXIMIZING_FLOOR),  # Alice P2
                Mock(success=True, principle=JusticePrinciple.MAXIMIZING_FLOOR)   # Bob P2
            ])
            
            # Run complete experiment
            experiment_manager = FrohlichExperimentManager(config)
            await experiment_manager.async_init()
            
            with patch.object(experiment_manager.phase1_manager, 'run_phase1') as mock_phase1, \
                 patch.object(experiment_manager.phase2_manager, 'run_phase2') as mock_phase2:
                
                # Mock Phase 1 results
                phase1_results = [
                    Mock(spec=Phase1Results, participant_name="Alice", 
                         final_principle_choice=JusticePrinciple.MAXIMIZING_FLOOR),
                    Mock(spec=Phase1Results, participant_name="Bob", 
                         final_principle_choice=JusticePrinciple.MAXIMIZING_FLOOR)
                ]
                mock_phase1.return_value = phase1_results
                
                # Mock Phase 2 results with consensus
                phase2_results = Mock(spec=Phase2Results)
                phase2_results.consensus_reached = True
                phase2_results.agreed_principle = JusticePrinciple.MAXIMIZING_FLOOR
                phase2_results.total_rounds = 2
                mock_phase2.return_value = phase2_results
                
                results = await experiment_manager.run_experiment()
                
                # Verify end-to-end results
                assert isinstance(results, ExperimentResults)
                assert results.consensus_reached is True
                assert results.agreed_principle == JusticePrinciple.MAXIMIZING_FLOOR
    
    @pytest.mark.asyncio
    async def test_complex_voting_end_to_end(self):
        """Test complete experiment with complex voting mechanism."""
        config = ExperimentConfiguration(
            experiment_id="e2e_complex",
            agents=[
                AgentConfiguration(name="Alice", language="english"),
                AgentConfiguration(name="Bob", language="english"),
                AgentConfiguration(name="Carol", language="english")
            ],
            phase1_config={"rounds": 2},
            phase2_config={"rounds": 5, "voting_detection_mode": "complex"}
        )
        
        with patch('experiment_agents.create_participant_agents_with_dynamic_temperature') as mock_participants, \
             patch('experiment_agents.UtilityAgent') as mock_utility_class:
            
            # Create mocked agents
            participants = [Mock(spec=ParticipantAgent, name=name) for name in ["Alice", "Bob", "Carol"]]
            mock_participants.return_value = participants
            mock_utility_class.return_value = Mock(spec=UtilityAgent)
            
            experiment_manager = FrohlichExperimentManager(config)
            await experiment_manager.async_init()
            
            with patch.object(experiment_manager.phase1_manager, 'run_phase1') as mock_phase1, \
                 patch.object(experiment_manager.phase2_manager, 'run_phase2') as mock_phase2:
                
                # Mock Phase 1 results (different initial preferences)
                phase1_results = [
                    Mock(spec=Phase1Results, participant_name="Alice", 
                         final_principle_choice=JusticePrinciple.MAXIMIZING_FLOOR),
                    Mock(spec=Phase1Results, participant_name="Bob", 
                         final_principle_choice=JusticePrinciple.MAXIMIZING_AVERAGE),
                    Mock(spec=Phase1Results, participant_name="Carol", 
                         final_principle_choice=JusticePrinciple.MAXIMIZING_FLOOR)
                ]
                mock_phase1.return_value = phase1_results
                
                # Mock Phase 2 results with voting resolution
                phase2_results = Mock(spec=Phase2Results)
                phase2_results.consensus_reached = True
                phase2_results.agreed_principle = JusticePrinciple.MAXIMIZING_FLOOR
                phase2_results.total_rounds = 4
                phase2_results.voting_occurred = True
                phase2_results.individual_votes = [1, 1, 1]  # All voted for principle 1
                mock_phase2.return_value = phase2_results
                
                results = await experiment_manager.run_experiment()
                
                # Verify complex voting results
                assert results.consensus_reached is True
                assert results.agreed_principle == JusticePrinciple.MAXIMIZING_FLOOR
                assert hasattr(results, 'voting_occurred') and results.voting_occurred is True
    
    @pytest.mark.asyncio
    async def test_multilingual_end_to_end(self):
        """Test complete multilingual experiment scenario."""
        config = ExperimentConfiguration(
            experiment_id="e2e_multilingual",
            agents=[
                AgentConfiguration(name="Alice", language="english"),
                AgentConfiguration(name="Ana", language="spanish"),
                AgentConfiguration(name="李明", language="mandarin")
            ],
            phase1_config={"rounds": 2},
            phase2_config={"rounds": 3, "voting_detection_mode": "simple"}
        )
        
        with patch('experiment_agents.create_participant_agents_with_dynamic_temperature') as mock_participants, \
             patch('experiment_agents.UtilityAgent') as mock_utility_class:
            
            # Create multilingual mocked agents
            participants = [
                Mock(spec=ParticipantAgent, name="Alice", language="english"),
                Mock(spec=ParticipantAgent, name="Ana", language="spanish"), 
                Mock(spec=ParticipantAgent, name="李明", language="mandarin")
            ]
            mock_participants.return_value = participants
            mock_utility_class.return_value = Mock(spec=UtilityAgent)
            
            experiment_manager = FrohlichExperimentManager(config)
            await experiment_manager.async_init()
            
            with patch.object(experiment_manager.phase1_manager, 'run_phase1') as mock_phase1, \
                 patch.object(experiment_manager.phase2_manager, 'run_phase2') as mock_phase2:
                
                # Mock multilingual Phase 1 results
                phase1_results = [
                    Mock(spec=Phase1Results, participant_name="Alice", 
                         final_principle_choice=JusticePrinciple.MAXIMIZING_FLOOR),
                    Mock(spec=Phase1Results, participant_name="Ana", 
                         final_principle_choice=JusticePrinciple.MAXIMIZING_FLOOR),
                    Mock(spec=Phase1Results, participant_name="李明", 
                         final_principle_choice=JusticePrinciple.MAXIMIZING_FLOOR)
                ]
                mock_phase1.return_value = phase1_results
                
                # Mock multilingual consensus in Phase 2
                phase2_results = Mock(spec=Phase2Results)
                phase2_results.consensus_reached = True
                phase2_results.agreed_principle = JusticePrinciple.MAXIMIZING_FLOOR
                phase2_results.total_rounds = 2
                phase2_results.multilingual_consensus = True
                mock_phase2.return_value = phase2_results
                
                results = await experiment_manager.run_experiment()
                
                # Verify multilingual consensus
                assert results.consensus_reached is True
                assert results.agreed_principle == JusticePrinciple.MAXIMIZING_FLOOR
                assert len(results.phase1_results) == 3  # All three participants


class TestErrorHandlingIntegration:
    """Test error handling across component boundaries."""
    
    @pytest.mark.asyncio
    async def test_phase1_error_propagation(self):
        """Test error propagation from Phase1 to ExperimentManager."""
        config = ExperimentConfiguration(
            experiment_id="error_test",
            agents=[AgentConfiguration(name="Alice", language="english")]
        )
        
        with patch('experiment_agents.create_participant_agents_with_dynamic_temperature') as mock_participants, \
             patch('experiment_agents.UtilityAgent') as mock_utility_class:
            
            mock_participants.return_value = [Mock(spec=ParticipantAgent)]
            mock_utility_class.return_value = Mock(spec=UtilityAgent)
            
            experiment_manager = FrohlichExperimentManager(config)
            await experiment_manager.async_init()
            
            # Mock Phase1 failure
            with patch.object(experiment_manager.phase1_manager, 'run_phase1') as mock_phase1:
                mock_phase1.side_effect = Exception("Phase 1 failed")
                
                # Error should propagate to experiment manager
                with pytest.raises(Exception, match="Phase 1 failed"):
                    await experiment_manager.run_experiment()
    
    @pytest.mark.asyncio
    async def test_agent_communication_error_integration(self):
        """Test integration of agent communication error handling."""
        config = ExperimentConfiguration(
            experiment_id="comm_error_test",
            agents=[AgentConfiguration(name="Alice", language="english")]
        )
        
        with patch('experiment_agents.create_participant_agents_with_dynamic_temperature') as mock_participants, \
             patch('experiment_agents.UtilityAgent') as mock_utility_class:
            
            # Mock agent that fails communication
            failing_agent = Mock(spec=ParticipantAgent)
            failing_agent.run.side_effect = Exception("Agent communication failed")
            mock_participants.return_value = [failing_agent]
            mock_utility_class.return_value = Mock(spec=UtilityAgent)
            
            experiment_manager = FrohlichExperimentManager(config)
            await experiment_manager.async_init()
            
            # Communication error should be handled at manager level
            with pytest.raises(Exception, match="Agent communication failed"):
                await experiment_manager.run_experiment()
    
    @pytest.mark.asyncio
    async def test_utility_agent_parsing_error_integration(self):
        """Test integration of utility agent parsing error handling."""
        config = ExperimentConfiguration(
            experiment_id="parsing_error_test",
            agents=[AgentConfiguration(name="Alice", language="english")]
        )
        
        with patch('experiment_agents.create_participant_agents_with_dynamic_temperature') as mock_participants, \
             patch('experiment_agents.UtilityAgent') as mock_utility_class:
            
            mock_participants.return_value = [Mock(spec=ParticipantAgent)]
            
            # Mock utility agent that fails parsing
            failing_utility_agent = Mock(spec=UtilityAgent)
            failing_utility_agent.parse_principle_choice_enhanced.side_effect = Exception("Parsing failed")
            mock_utility_class.return_value = failing_utility_agent
            
            experiment_manager = FrohlichExperimentManager(config)
            await experiment_manager.async_init()
            
            # Parsing error should be handled appropriately
            with pytest.raises(Exception, match="Parsing failed"):
                await experiment_manager.run_experiment()


class TestPerformanceIntegration:
    """Test performance characteristics of integrated components."""
    
    @pytest.mark.asyncio
    async def test_concurrent_agent_execution_integration(self):
        """Test that agents execute concurrently for performance."""
        config = ExperimentConfiguration(
            experiment_id="perf_test",
            agents=[
                AgentConfiguration(name=f"Agent{i}", language="english") 
                for i in range(4)
            ],
            phase1_config={"rounds": 1}
        )
        
        with patch('experiment_agents.create_participant_agents_with_dynamic_temperature') as mock_participants, \
             patch('experiment_agents.UtilityAgent') as mock_utility_class:
            
            # Mock agents with slight delays to test concurrency
            participants = []
            for i in range(4):
                agent = Mock(spec=ParticipantAgent, name=f"Agent{i}")
                
                async def slow_response(*args, **kwargs):
                    await asyncio.sleep(0.05)  # Small delay
                    return Mock(messages=["response"])
                
                agent.run.side_effect = slow_response
                participants.append(agent)
            
            mock_participants.return_value = participants
            mock_utility_class.return_value = Mock(spec=UtilityAgent)
            
            experiment_manager = FrohlichExperimentManager(config)
            await experiment_manager.async_init()
            
            # Mock parsing to avoid delays
            experiment_manager.utility_agent.parse_principle_choice_enhanced.return_value = Mock(
                success=True, principle=JusticePrinciple.MAXIMIZING_FLOOR
            )
            
            # Mock Phase2 to focus on Phase1 performance
            with patch.object(experiment_manager.phase2_manager, 'run_phase2') as mock_phase2:
                mock_phase2.return_value = Mock(spec=Phase2Results, consensus_reached=True)
                
                import time
                start_time = time.time()
                results = await experiment_manager.run_experiment()
                end_time = time.time()
                
                # Should complete faster than sequential execution (4 * 0.05 = 0.2s)
                assert end_time - start_time < 0.15  # Concurrent execution benefit
    
    def test_memory_efficiency_integration(self):
        """Test memory efficiency across integrated components."""
        # Test with many agents to validate memory efficiency
        config = ExperimentConfiguration(
            experiment_id="memory_test",
            agents=[
                AgentConfiguration(name=f"Agent{i}", language="english") 
                for i in range(10)
            ]
        )
        
        with patch('experiment_agents.create_participant_agents_with_dynamic_temperature') as mock_participants, \
             patch('experiment_agents.UtilityAgent') as mock_utility_class:
            
            mock_participants.return_value = [Mock(spec=ParticipantAgent) for _ in range(10)]
            mock_utility_class.return_value = Mock(spec=UtilityAgent)
            
            experiment_manager = FrohlichExperimentManager(config)
            
            # Should handle many agents without memory issues
            assert len(experiment_manager.config.agents) == 10
            assert experiment_manager.experiment_id is not None


